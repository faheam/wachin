<Window x:Class="Wachin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Wachin" Width="1280" Height="800"
        MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/icon.ico"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize"
        MaxHeight="{x:Static SystemParameters.MaximizedPrimaryScreenHeight}"
        MaxWidth="{x:Static SystemParameters.MaximizedPrimaryScreenWidth}">

    <!-- Chrome personalizado: esquinas redondeadas + redimensionado nativo -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="10"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <!-- Raiz con esquinas redondeadas y borde sutil -->
    <Border x:Name="RootChrome" CornerRadius="10" Background="{DynamicResource BgApp}"
            BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1">
        <Grid x:Name="RootGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ==================== BARRA DE TITULO PERSONALIZADA ==================== -->
            <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{DynamicResource BgTitlebar}"
                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnTitleBarMouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Logo + nombre -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Image Source="Assets/icon.png" Width="16" Height="16" Stretch="Uniform"/>
                        <TextBlock Text="Wachin" FontFamily="{StaticResource DisplayFont}" FontSize="11.5"
                                   FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Optimizador de PC" FontSize="10.5"
                                   Foreground="{DynamicResource TextMuted}"
                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Controles de ventana -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource WinButton}" Click="OnMinimize" ToolTip="Minimizar">
                            <TextBlock Text="&#xE921;" FontSize="10"/>
                        </Button>
                        <Button Style="{StaticResource WinButton}" Click="OnMaximizeRestore" ToolTip="Maximizar">
                            <TextBlock x:Name="MaxGlyph" Text="&#xE922;" FontSize="10"/>
                        </Button>
                        <Button Style="{StaticResource WinButtonClose}" Click="OnClose" ToolTip="Cerrar">
                            <TextBlock Text="&#xE8BB;" FontSize="10"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== SIDEBAR ==================== -->
            <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource GlassSidebarBrush}"
                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- Logo del sidebar -->
                    <StackPanel DockPanel.Dock="Top" Margin="16,18,16,12">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="40" Height="40" CornerRadius="8"
                                    Background="{DynamicResource GlassPanel}"
                                    BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1">
                                <Image Source="Assets/icon.png" Width="26" Height="26"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="WACHIN" FontFamily="{StaticResource DisplayFont}"
                                           FontSize="18" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="OPTIMIZADOR DE SISTEMA" FontFamily="{StaticResource DisplayFont}"
                                           FontSize="8" Foreground="{DynamicResource TextMuted}"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Height="1" Margin="2,12,2,0" Background="{DynamicResource Divider}"/>
                    </StackPanel>

                    <!-- Version + HUD -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="14,0,14,14">
                        <Border Style="{StaticResource DividerStyle}" Margin="0,0,0,10"/>
                        <!-- Panel HUD (bandeja + nucleo) -->
                        <Border Background="{DynamicResource BgChip}" CornerRadius="8" Padding="1.5"
                                BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" Margin="0,0,0,10">
                            <Border Background="{DynamicResource GlassHudBrush}" CornerRadius="6.5"
                                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                    Padding="12,10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Ellipse Width="7" Height="7" Fill="{DynamicResource Success}" Margin="0,0,8,0"
                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="SISTEMA EN LINEA" FontFamily="{StaticResource DisplayFont}"
                                                   FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Success}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="HudClock" Text="--:--:--" FontFamily="{StaticResource DisplayFont}"
                                                   FontSize="9" Foreground="{DynamicResource Accent}"
                                                   Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <Grid Margin="0,4,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="RAM" FontSize="9" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="HudRamPct" Text="--%" FontSize="9"
                                                   FontWeight="Bold" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <ProgressBar x:Name="HudRamBar" Height="4" Minimum="0" Maximum="100" Value="0"
                                                 Foreground="{DynamicResource Accent}" Background="{DynamicResource BgChip}"/>
                                    <TextBlock x:Name="HudRamDetail" Text="--" FontSize="8.5"
                                               Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0"/>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="ACTIVO" FontSize="8.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="HudUptime" Text="--" FontSize="8.5"
                                                   Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Border>
                        <TextBlock Text="v1.0.0  |  NUCLEO OPTIMIZADOR" Style="{StaticResource Caption}"
                                   FontSize="8.5" Margin="10,0,0,0"/>
                    </StackPanel>

                    <!-- Navegacion -->
                    <ListBox x:Name="NavList" Margin="8,0" SelectionChanged="OnNavChanged"
                             VerticalAlignment="Stretch" BorderThickness="0"
                             Background="Transparent">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="Padding" Value="12,9"/>
                                <Setter Property="Margin" Value="4,1"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="30"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Barra acento (seleccion) -->
                                                    <Border x:Name="AccentBar" Grid.Column="0" Width="3" Height="16"
                                                            CornerRadius="1.5" Background="{DynamicResource Accent}"
                                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                                            Visibility="Collapsed"/>
                                                    <TextBlock Grid.Column="0" FontFamily="{StaticResource IconFont}" FontSize="15"
                                                               VerticalAlignment="Center" Margin="10,0,0,0" Text="{Binding Glyph}"
                                                               Foreground="{TemplateBinding Foreground}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="{TemplateBinding FontSize}"
                                                               FontWeight="{TemplateBinding FontWeight}"
                                                               FontFamily="{StaticResource AppFont}"
                                                               VerticalAlignment="Center" Margin="8,0,0,0"
                                                               Foreground="{TemplateBinding Foreground}"/>
                                                    <Border Grid.Column="2" x:Name="Badge" Background="{DynamicResource Accent}"
                                                            CornerRadius="4" Padding="7,1" Margin="6,0,0,0"
                                                            VerticalAlignment="Center" HorizontalAlignment="Right"
                                                            Visibility="{Binding BadgeVisible}">
                                                        <TextBlock Text="{Binding BadgeText}" FontSize="10.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextOnAccent}"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="FontSize" Value="10.5"/>
                                                    <Setter Property="Padding" Value="14,14,14,6"/>
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource AccentSoft}"/>
                                                    <Setter TargetName="AccentBar" Property="Visibility" Value="Visible"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource BgCardHover}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ==================== CONTENIDO ==================== -->
            <DockPanel Grid.Row="1" Grid.Column="1" Background="{DynamicResource GlassContentBrush}">

                <!-- Top bar -->
                <Border DockPanel.Dock="Top" Background="Transparent"
                        BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1"
                        Padding="28,16,14,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="PageTitle" Style="{StaticResource H1}"/>
                            <TextBlock x:Name="PageSubtitle" Style="{StaticResource Body}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Crear punto de restauracion"
                                    Style="{StaticResource PrimaryButton}" FontSize="12"
                                    Command="{Binding CreateRestorePointCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Contenido principal -->
                <Grid>
                    <ContentControl x:Name="ContentHost" Content="{Binding CurrentView}" Margin="0"/>
                </Grid>

            </DockPanel>

            <!-- ==================== TOAST HOST ==================== -->
            <ItemsControl x:Name="ToastHost" Grid.Row="1" Grid.Column="1"
                          HorizontalAlignment="Right" VerticalAlignment="Bottom"
                          Margin="0,0,24,24" IsHitTestVisible="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel VerticalAlignment="Bottom"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </Grid>
    </Border>
</Window>
