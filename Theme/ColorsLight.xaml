<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================== TEMA CLARO (Fluent-Inspired) ===================== -->

    <!-- Fondos — con más profundidad y capas -->
    <SolidColorBrush x:Key="BgApp" Color="#F8F9FC" />
    <SolidColorBrush x:Key="BgSidebar" Color="#F0F2F5" />
    <SolidColorBrush x:Key="BgCard" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BgCardHover" Color="#F4F6F9" />
    <SolidColorBrush x:Key="BgInput" Color="#FAFBFC" />
    <SolidColorBrush x:Key="BgChip" Color="#E8ECF1" />
    <SolidColorBrush x:Key="BgOverlay" Color="#1B1F27" />

    <!-- Bordes — más sutiles y elegantes -->
    <SolidColorBrush x:Key="BorderDefault" Color="#E1E5EB" />
    <SolidColorBrush x:Key="BorderStrong" Color="#D0D5DC" />
    <SolidColorBrush x:Key="BorderSubtle" Color="#EDF0F4" />

    <!-- Texto — jerarquía más clara -->
    <SolidColorBrush x:Key="TextPrimary" Color="#1A1D24" />
    <SolidColorBrush x:Key="TextSecondary" Color="#5F6877" />
    <SolidColorBrush x:Key="TextMuted" Color="#8D95A3" />
    <SolidColorBrush x:Key="TextOnAccent" Color="#FFFFFF" />

    <!-- Acento — teal premium con gradientes ricos -->
    <SolidColorBrush x:Key="Accent" Color="#0D9488" />
    <SolidColorBrush x:Key="AccentHover" Color="#14B8A6" />
    <SolidColorBrush x:Key="AccentPressed" Color="#0F766E" />
    <SolidColorBrush x:Key="AccentSoft" Color="#E6F5F3" />
    <SolidColorBrush x:Key="AccentSofter" Color="#F0FAF8" />
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0D9488" Offset="0" />
        <GradientStop Color="#6366F1" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGradientSoft" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E6F5F3" Offset="0" />
        <GradientStop Color="#EDE9FE" Offset="1" />
    </LinearGradientBrush>

    <!-- Riesgo — colores más ricos -->
    <SolidColorBrush x:Key="RiskLow" Color="#059669" />
    <SolidColorBrush x:Key="RiskLowSoft" Color="#ECFDF5" />
    <SolidColorBrush x:Key="RiskMedium" Color="#D97706" />
    <SolidColorBrush x:Key="RiskMediumSoft" Color="#FFFBEB" />
    <SolidColorBrush x:Key="RiskHigh" Color="#DC2626" />
    <SolidColorBrush x:Key="RiskHighSoft" Color="#FEF2F2" />

    <!-- Estados -->
    <SolidColorBrush x:Key="Success" Color="#059669" />
    <SolidColorBrush x:Key="SuccessSoft" Color="#ECFDF5" />
    <SolidColorBrush x:Key="Info" Color="#2563EB" />
    <SolidColorBrush x:Key="InfoSoft" Color="#EFF6FF" />
    <SolidColorBrush x:Key="Danger" Color="#DC2626" />
    <SolidColorBrush x:Key="DangerHover" Color="#B91C1C" />
    <SolidColorBrush x:Key="DangerSoft" Color="#FEF2F2" />

    <!-- Varios -->
    <SolidColorBrush x:Key="ScrollThumb" Color="#C1C7D0" />
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#A0A8B4" />
    <SolidColorBrush x:Key="Divider" Color="#E8ECF0" />
    <SolidColorBrush x:Key="ToastBg" Color="#FFFFFF" />

</ResourceDictionary>
