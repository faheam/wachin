<UserControl x:Class="Wachin.Views.ServicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:serv="clr-namespace:Wachin.Services"
             xmlns:local="clr-namespace:Wachin.Services">
    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Servicios de Windows" Style="{StaticResource H1}" Margin="0,0,0,4"/>
            <TextBlock Text="Desactiva servicios que no necesitas. Los recomendados aparecen primero."
                       Style="{StaticResource Body}" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Search & Filter -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ToggleButton x:Name="RecommendedToggle" Content="Solo recomendados" IsChecked="True"
                          Checked="OnFilterChanged" Unchecked="OnFilterChanged" Grid.Column="0"/>
            <TextBox x:Name="SearchBox" Grid.Column="2" Tag="Buscar servicio..." TextChanged="OnSearchChanged"/>
            <Button Grid.Column="4" Content="Refrescar" Style="{StaticResource SecondaryButton}"
                    Click="OnRefresh"/>
        </Grid>

        <!-- Services List - Full Width -->
        <ListBox Grid.Row="4" x:Name="ServiceList" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 BorderThickness="0" Background="Transparent">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,4"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="20,16" Margin="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Info -->
                            <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodyBold}" FontSize="14" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}"
                                           TextWrapping="Wrap" Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal">
                                    <Border CornerRadius="4" Padding="6,2" Margin="0,0,8,0"
                                            Background="{Binding Risk, Converter={serv:RiskToSoftBrushConverter}}">
                                        <TextBlock Text="{Binding Risk, Converter={serv:RiskToTextConverter}}"
                                                   FontSize="10" Foreground="{Binding Risk, Converter={serv:RiskToBrushConverter}}"/>
                                    </Border>
                                    <Border CornerRadius="4" Padding="6,2" Margin="0,0,8,0" Background="{DynamicResource BgChip}">
                                        <TextBlock Text="{Binding StartTypeLabel}" Style="{StaticResource Caption}" FontSize="10"/>
                                    </Border>
                                    <Border CornerRadius="4" Padding="6,2" Background="{DynamicResource BgChip}">
                                        <TextBlock Style="{StaticResource Caption}" FontSize="10"
                                                   Foreground="{Binding State, Converter={local:StatusToColorConverter}}"
                                                   Text="{Binding State, StringFormat='Estado: {0}'}"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <!-- Actions -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="DisableBtn" Content="Desactivar" Style="{StaticResource DisableServiceButton}"
                                        Click="OnDisable" Margin="0,0,4,0" MinWidth="90"
                                        Visibility="{Binding WasChanged, Converter={serv:InverseBoolConverter}}"/>
                                <Button x:Name="RestoreBtn" Content="Restaurar" Style="{StaticResource SmallDangerButton}"
                                        Click="OnRestore" Margin="0,0,4,0" MinWidth="90"
                                        Visibility="{Binding WasChanged, Converter={serv:BoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
