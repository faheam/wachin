<UserControl x:Class="Wachin.Views.WindowsUpdateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:serv="clr-namespace:Wachin.Services">
    <Grid Margin="20,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Windows Update y Reparacion" Style="{StaticResource H1}"/>
            <TextBlock Text="Busca actualizaciones, repara archivos del sistema y gestiona Windows Update" Style="{StaticResource Body}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Quick Actions -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Acciones rapidas" Style="{StaticResource H3}" Margin="0,0,0,12"/>
                        <WrapPanel>
                            <Button Content="Buscar actualizaciones" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" Click="CheckUpdates_Click"/>
                            <Button Content="Abrir Configuracion de Update" Style="{StaticResource BaseButton}" Margin="0,0,8,8" Click="OpenSettings_Click"/>
                            <Button Content="Verificar integridad (SFC)" Style="{StaticResource BaseButton}" Margin="0,0,8,8" Click="RunSFC_Click"/>
                            <Button Content="Reparar imagen (DISM)" Style="{StaticResource BaseButton}" Margin="0,0,8,8" Click="RunDISM_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Pending Updates -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Actualizaciones pendientes" Style="{StaticResource H3}" Margin="0,0,0,4"/>
                        <TextBlock x:Name="PendingCountText" Text="Buscando actualizaciones..." Style="{StaticResource Caption}" Margin="0,0,0,12"/>

                        <ListBox x:Name="PendingList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BgChip}" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="{DynamicResource AccentSoft}" CornerRadius="6" Padding="8,4" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding Size}" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <!-- Installed Updates History -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Historial de actualizaciones" Style="{StaticResource H3}" Margin="0,0,0,4"/>
                        <TextBlock x:Name="HistoryCountText" Text="Cargando historial..." Style="{StaticResource Caption}" Margin="0,0,0,12"/>

                        <ListBox x:Name="HistoryList" Background="Transparent" BorderThickness="0" MaxHeight="300" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BgChip}" CornerRadius="8" Padding="12" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding KB}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Date, StringFormat='{}{0:dd/MM/yyyy}'}" Style="{StaticResource Caption}" FontSize="10"/>
                                                <Border Background="{DynamicResource SuccessSoft}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right" Margin="0,4,0,0">
                                                    <TextBlock Text="Instalado" Foreground="{DynamicResource Success}" FontSize="10" FontWeight="SemiBold"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Status Bar -->
        <Border Grid.Row="2" Style="{StaticResource Card}" x:Name="StatusBar" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="StatusIcon" Text="*" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" FontWeight="Bold"/>
                <TextBlock x:Name="StatusText" Text="" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
