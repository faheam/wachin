<UserControl x:Class="Wachin.Views.ProgramsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Programas esenciales" Style="{StaticResource H1}"/>
            <TextBlock Text="Las apps mas descargadas al formatear un PC, instaladas con un clic desde sus repositorios oficiales" Style="{StaticResource Body}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Winget availability banner -->
        <Border Grid.Row="1" x:Name="WingetBanner" Style="{StaticResource Card}" Visibility="Collapsed" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="BannerIcon" Text="*" FontSize="14" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock x:Name="BannerText" Text="" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}"/>
            </StackPanel>
        </Border>

        <!-- Programs list (grouped by category) -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ProgramsList">
                <ItemsControl.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource H2}" Margin="0,18,0,8"/>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ItemsControl.GroupStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <!-- Title and chips -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                        <Border Background="{DynamicResource CreamChip}" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SourceLabel}" FontSize="10" Foreground="{DynamicResource CreamChipText}" FontWeight="SemiBold"/>
                                        </Border>
                                        <Border Background="{DynamicResource CreamChip}" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding SizeVisibility}">
                                            <TextBlock Text="{Binding SizeLabel}" FontSize="10" Foreground="{DynamicResource CreamChipText}" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Description -->
                                    <TextBlock Text="{Binding Description}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"
                                               Foreground="{DynamicResource TextSecondary}"/>

                                    <!-- Official site link -->
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontSize="11">
                                            <Hyperlink Click="OpenHomepage_Click" Tag="{Binding}">
                                                <TextBlock Text="Pagina oficial" Foreground="{DynamicResource Accent}"/>
                                            </Hyperlink>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Install button -->
                                <Button Grid.Column="1" Content="{Binding ButtonText}" Style="{Binding ButtonStyle}"
                                        Padding="16,10" VerticalAlignment="Center" Margin="16,0,0,0"
                                        Click="Install_Click" Tag="{Binding}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Status Bar -->
        <Border Grid.Row="3" Style="{StaticResource Card}" x:Name="StatusBar" Visibility="Collapsed" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusIcon" Text="*" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" FontWeight="Bold"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Text="" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}"/>
                    <ProgressBar x:Name="ProgressBar" Height="4" Margin="0,6,0,0" Minimum="0" Maximum="100" Value="0"
                                 Foreground="{DynamicResource Accent}" Background="{DynamicResource BgChip}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
