<UserControl x:Class="Wachin.Views.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:serv="clr-namespace:Wachin.Services">
    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Tareas programadas" Style="{StaticResource H1}" Margin="0,0,0,4"/>
            <TextBlock Text="Gestiona las tareas automaticas de Windows y aplicaciones"
                       Style="{StaticResource Body}" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Warning -->
        <Border Grid.Row="2" Background="{DynamicResource InfoSoft}" CornerRadius="8" Padding="16,12">
            <TextBlock Text="Desactivar tareas del sistema puede afectar Windows. Solo cambia lo que entiendas."
                       Style="{StaticResource Body}" Foreground="{DynamicResource Info}"/>
        </Border>

        <!-- Search -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="SearchBox" Tag="Buscar tarea..." TextChanged="OnSearch" Margin="0,0,8,0"/>
            <Button Grid.Column="1" Content="Refrescar" Style="{StaticResource SecondaryButton}"
                    Click="OnRefresh"/>
        </Grid>

        <!-- Tasks List -->
        <ListBox Grid.Row="6" x:Name="TaskList" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 BorderThickness="0" Background="Transparent">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,4"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DataTemplate.Resources>
                        <!-- Cream white: todos los TextBlock del item heredan este
                             Foreground (los contenedores Border/Grid no tienen Foreground) -->
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                        </Style>
                    </DataTemplate.Resources>
                    <Border Style="{StaticResource Card}" Padding="20,16" Margin="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Info -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Path}" Style="{StaticResource BodyBold}" FontSize="14" Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Border Background="{DynamicResource BgChip}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock FontSize="11">
                                            <Run Text="Estado: "/>
                                            <Run Text="{Binding State, Mode=OneWay}" FontWeight="SemiBold"/>
                                        </TextBlock>
                                    </Border>
                                    <Border Background="{DynamicResource BgChip}" CornerRadius="4" Padding="6,2">
                                        <TextBlock FontSize="11">
                                            <Run Text="Accion: "/>
                                            <Run Text="{Binding Action, Mode=OneWay}"/>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="TriggerText" Text="{Binding Trigger}"
                                           FontSize="11.5" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Desactivar Button -->
                            <Button Grid.Column="1" x:Name="ToggleBtn" Content="Desactivar"
                                    Style="{StaticResource SmallDangerButton}" Click="OnToggle" MinWidth="100"
                                    VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
