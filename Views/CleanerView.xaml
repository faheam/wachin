<UserControl x:Class="Wachin.Views.CleanerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:serv="clr-namespace:Wachin.Services">
    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Limpiador de archivos" Style="{StaticResource H1}" Margin="0,0,0,4"/>
            <TextBlock Text="Selecciona que limpiar. Los archivos temporales se regeneran si se necesitan."
                       Style="{StaticResource Body}" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <Button Content="Analizar espacio" Style="{StaticResource PrimaryButton}"
                    Click="OnScan" Margin="0,0,8,0"/>
            <Button x:Name="CleanBtn" Content="Limpiar seleccionados" Style="{StaticResource DangerButton}"
                    Click="OnClean" IsEnabled="False"/>
        </StackPanel>

        <!-- Progress -->
        <Grid Grid.Row="4">
            <ProgressBar x:Name="Progress" Height="4" IsIndeterminate="True" Visibility="Collapsed"/>
            <TextBlock x:Name="StatusText" Style="{StaticResource Body}" VerticalAlignment="Center"/>
        </Grid>

        <!-- Categories List - Full Width -->
        <ListBox Grid.Row="6" x:Name="CleanerList" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 BorderThickness="0" Background="Transparent">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,4"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="20,16" Margin="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <!-- Checkbox -->
                            <CheckBox Grid.Column="0" x:Name="SelChk" IsChecked="{Binding Selected}"
                                      Style="{StaticResource Switch}" Margin="0,0,16,0"/>

                            <!-- Info -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource BodyBold}" FontSize="14" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Risk Badge -->
                            <Border Grid.Column="2" CornerRadius="6" Padding="8,3" Margin="0,0,16,0"
                                    VerticalAlignment="Center"
                                    Background="{Binding Risk, Converter={serv:RiskToSoftBrushConverter}}">
                                <TextBlock Text="{Binding Risk, Converter={serv:RiskToTextConverter}}"
                                           FontSize="11" Foreground="{Binding Risk, Converter={serv:RiskToBrushConverter}}"/>
                            </Border>

                            <!-- Size -->
                            <TextBlock Grid.Column="3" Text="{Binding SizeLabel}"
                                       Style="{StaticResource Body}" FontWeight="SemiBold" FontSize="14"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Result -->
        <Border Grid.Row="8" x:Name="ResultBorder" Style="{StaticResource Card}" Visibility="Collapsed">
            <TextBlock x:Name="ResultText" Style="{StaticResource BodyBold}" FontSize="14"/>
        </Border>
    </Grid>
</UserControl>
