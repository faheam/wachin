<UserControl x:Class="Wachin.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:serv="clr-namespace:Wachin.Services">
    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Programas de inicio" Style="{StaticResource H1}" Margin="0,0,0,4"/>
            <TextBlock Text="Gestiona las aplicaciones que se ejecutan automaticamente al iniciar Windows"
                       Style="{StaticResource Body}" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Actions -->
        <Button Grid.Row="2" Content="Refrescar lista" Style="{StaticResource SecondaryButton}"
                Click="OnRefresh" HorizontalAlignment="Left"/>

        <!-- Items List - Full Width -->
        <ListBox Grid.Row="4" x:Name="List" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 BorderThickness="0" Background="Transparent">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,4"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="20,16" Margin="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Info -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource BodyBold}" FontSize="14" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding Command}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                           MaxWidth="600" ToolTip="{Binding Command}"/>
                                <TextBlock Text="{Binding Source}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                                           Foreground="{DynamicResource TextMuted}"/>
                            </StackPanel>

                            <!-- Actions -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="ToggleBtn" Content="{Binding IsEnabled, Converter={serv:InverseBoolConverter}}"
                                        Style="{StaticResource SmallButton}" Click="OnToggle" Margin="0,0,8,0" MinWidth="80"/>
                                <Button Content="Eliminar" Style="{StaticResource SmallDangerButton}"
                                        Click="OnDelete" MinWidth="80"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
