<UserControl x:Class="Wachin.Views.BloatwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:serv="clr-namespace:Wachin.Services">
    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Apps preinstaladas de Windows" Style="{StaticResource BodyBold}" FontSize="14" Margin="0,0,0,4"/>
                <TextBlock Text="Haz clic en Escanear para buscar apps preinstaladas que puedes eliminar para liberar espacio."
                           Style="{StaticResource Body}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <Button x:Name="ScanBtn" Content="Escanear apps" Style="{StaticResource PrimaryButton}"
                    Click="OnScan" Margin="0,0,8,0"/>
            <Button x:Name="RemoveBtn" Content="Eliminar seleccionadas" Style="{StaticResource DangerButton}"
                    Click="OnRemoveAll" IsEnabled="False"/>
            <TextBlock x:Name="StatusText" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </StackPanel>

        <!-- Empty state (shown before scan) -->
        <Border x:Name="EmptyState" Grid.Row="4" Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel HorizontalAlignment="Center" Margin="0,40,0,0">
                <TextBlock Text="No se ha escaneado aun" FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource Danger}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="Haz clic en el boton Escanear para buscar apps preinstaladas de Windows."
                           Style="{StaticResource Body}" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <Button Content="Escanear apps" Style="{StaticResource PrimaryButton}"
                        Click="OnScan" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Results - 3 Column Grid -->
        <ScrollViewer Grid.Row="4" x:Name="ResultsScroll" Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="BloatGrid">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,8,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- App Name -->
                                <TextBlock Grid.Row="0" Text="{Binding Name}" Style="{StaticResource BodyBold}" FontSize="13"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>

                                <!-- Description -->
                                <TextBlock Grid.Row="2" Text="{Binding Description}" Style="{StaticResource Caption}"
                                           TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis"/>

                                <!-- Bottom Row: Risk + Button -->
                                <Grid Grid.Row="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Risk Badge -->
                                    <Border Grid.Column="0" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                            Background="{Binding Risk, Converter={serv:RiskToSoftBrushConverter}}" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Risk, Converter={serv:RiskToTextConverter}}"
                                                   FontSize="10" Foreground="{Binding Risk, Converter={serv:RiskToBrushConverter}}"/>
                                    </Border>

                                    <!-- Remove Button -->
                                    <Button Grid.Column="1" Content="Eliminar" Style="{StaticResource SmallDangerButton}"
                                            Click="OnRemoveSingle" VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
